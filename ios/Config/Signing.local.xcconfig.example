// Copy to Signing.local.xcconfig (gitignored) and fill in your own values.
//
// The Team ID is the ten-character string in the top right of developer.apple.com/account, or in
// Xcode under Settings > Accounts > Manage Certificates.
RAILMAP_DEVELOPMENT_TEAM = ABCDE12345

