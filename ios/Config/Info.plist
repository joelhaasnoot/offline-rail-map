<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the app looks for the list of downloadable country packs; set MANIFEST_URL in the build settings. -->
	<key>ManifestURL</key>
	<string>$(MANIFEST_URL)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.offlinerailmap.ios.geo</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>geo</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets debug builds read packs served from the development machine. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
