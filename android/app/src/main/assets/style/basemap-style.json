{
  "version": 8,
  "name": "Offline railway basemap",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "{{BASEMAP_TILES}}",
      "attribution": "<a href=\"https://www.openstreetmap.org/copyright\">\u00a9 OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f4f1ec"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landcover",
      "maxzoom": 14,
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "wood",
          "#dfe8d3",
          "grass",
          "#e9eedc",
          "farmland",
          "#f0eee0",
          "wetland",
          "#dde6e0",
          "sand",
          "#f2ecd6",
          "ice",
          "#f7f8f8",
          "#ece9e1"
        ],
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.5,
          12,
          0.8
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "basemap",
      "source-layer": "landuse",
      "minzoom": 9,
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          "residential",
          "#e9e5df",
          "neighbourhood",
          "#e9e5df",
          "suburb",
          "#e9e5df",
          "commercial",
          "#e9e2e2",
          "retail",
          "#e9e2e2",
          "industrial",
          "#e4e0e6",
          "railway",
          "#e3dfe3",
          "cemetery",
          "#dfe6d9",
          "hospital",
          "#eee3e3",
          "school",
          "#ece7dc",
          "university",
          "#ece7dc",
          "college",
          "#ece7dc",
          "military",
          "#e6e3dc",
          "quarry",
          "#e3dfd8",
          "#e9e5df"
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "basemap",
      "source-layer": "park",
      "minzoom": 8,
      "paint": {
        "fill-color": "#dbe8cd",
        "fill-opacity": 0.6,
        "fill-antialias": false
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "basemap",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "fill-color": "#b8d0e8",
        "fill-antialias": false
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "basemap",
      "source-layer": "waterway",
      "minzoom": 9,
      "paint": {
        "line-color": "#b8d0e8",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          9,
          0.5,
          14,
          2.5,
          18,
          8
        ]
      }
    },
    {
      "id": "aeroway-area",
      "type": "fill",
      "source": "basemap",
      "source-layer": "aeroway",
      "minzoom": 10,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#e6e4e4",
        "fill-antialias": false
      }
    },
    {
      "id": "aeroway-runway",
      "type": "line",
      "source": "basemap",
      "source-layer": "aeroway",
      "minzoom": 10,
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "runway",
              "taxiway"
            ]
          ]
        ]
      ],
      "paint": {
        "line-color": "#d5d3d3",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          10,
          1,
          16,
          20
        ]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "minzoom": 4,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          4
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ],
      "paint": {
        "line-color": "#c6bccb",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.5,
          10,
          1.5
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "basemap",
      "source-layer": "boundary",
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "admin_level"
          ],
          2
        ],
        [
          "!=",
          [
            "get",
            "maritime"
          ],
          1
        ]
      ],
      "paint": {
        "line-color": "#a292ad",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          2,
          0.8,
          8,
          2,
          12,
          3
        ],
        "line-dasharray": [
          4,
          2
        ]
      }
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "minor",
              "service",
              "tertiary"
            ]
          ]
        ],
        [
          "!=",
          [
            "get",
            "brunnel"
          ],
          "tunnel"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#d9d5cf",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          13,
          1.5,
          16,
          6,
          20,
          24
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "minor",
              "service",
              "tertiary"
            ]
          ]
        ],
        [
          "!=",
          [
            "get",
            "brunnel"
          ],
          "tunnel"
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          13,
          0.8,
          16,
          4.5,
          20,
          20
        ]
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "secondary",
              "primary"
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "primary",
          "#f3e2bf",
          "#f7edd6"
        ],
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          9,
          0.8,
          13,
          2.5,
          16,
          7,
          20,
          26
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "basemap",
      "source-layer": "transportation",
      "minzoom": 5,
      "filter": [
        "all",
        [
          "==",
          [
            "geometry-type"
          ],
          "LineString"
        ],
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "motorway",
              "trunk"
            ]
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ecc9a9",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.4
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          9,
          1.5,
          13,
          4,
          16,
          9,
          20,
          30
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.6,
          9,
          1
        ]
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "transportation_name",
      "minzoom": 14,
      "filter": [
        "!",
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "rail",
              "transit",
              "path",
              "track"
            ]
          ]
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "OpenRailwayMap-Regular"
        ],
        "text-size": 11,
        "text-max-angle": 30,
        "symbol-spacing": 350
      },
      "paint": {
        "text-color": "#7a756e",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "water-name-line",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "water_name",
      "minzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "OpenRailwayMap-Italic"
        ],
        "text-size": 11,
        "symbol-placement": "line"
      },
      "paint": {
        "text-color": "#6b8fb3",
        "text-halo-color": "#e8f0f8",
        "text-halo-width": 1
      },
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ]
    },
    {
      "id": "water-name-point",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "water_name",
      "minzoom": 6,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "OpenRailwayMap-Italic"
        ],
        "text-size": 11,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#6b8fb3",
        "text-halo-color": "#e8f0f8",
        "text-halo-width": 1
      },
      "filter": [
        "!=",
        [
          "geometry-type"
        ],
        "LineString"
      ]
    },
    {
      "id": "place-other",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "minzoom": 11,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "village",
