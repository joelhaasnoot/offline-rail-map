        "text-max-width": 8
      },
      "paint": {
        "text-color": "#3f3c37",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "basemap",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 15,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "city"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "OpenRailwayMap-Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          8,
          13,
          13,
          18
        ],
        "text-max-width": 8,
        "symbol-sort-key": [
          "coalesce",
          [
            "get",
            "rank"
          ],
          10
        ]
      },
      "paint": {
        "text-color": "#2d2b28",
        "text-halo-color": "#f4f1ec",
        "text-halo-width": 1.5
